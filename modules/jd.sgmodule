#!name=京东 去广告 (Adblock Hub)
#!desc=融合 103516 与可莉双源并自动修复 Surge 兼容问题。上游最新日期：2026-11-02 21:00。以 103516 为主（保留比价等附加脚本），清洗方括号脚本名并去重融合可莉独有规则。
#!category=去广告
#!date=2026-11-02 21:00
#!homepage=https://github.com/xfoxtbat/surge-adblock-hub
#!arguments=Manmanbuy-Cookie:"",JDPrice-TitleEmbed:#,JDPrice-DetailNotify:#,JDPrice-DetailEmbed-Table:"",JDPrice-DetailEmbed-Line:#
#!arguments-desc=Manmanbuy-Cookie: [京东比价]获取慢慢买Cookie\n首次使用请先打开【慢慢买】APP，提示【获取ck成功🎉】即可正常比价。\n可选值: 留空启用, # 禁用\n\nJDPrice-TitleEmbed: [京东比价]标题嵌入版\n点击商品标题即可直接查看嵌入式历史价格\n可选值: 留空启用, # 禁用\n\nJDPrice-DetailNotify: [京东比价]详情通知版\n点击商品详情页通过弹窗通知查看历史价格\n可选值: 留空启用, # 禁用\n\nJDPrice-DetailEmbed-Table: [京东比价]详情嵌入版（表格图）\n点击商品详情页即可直接查看嵌入式历史价格\n可选值: 留空启用, # 禁用\n\nJDPrice-DetailEmbed-Line: [京东比价]详情嵌入版（折线图）\n点击商品详情页即可直接查看嵌入式历史价格\n可选值: 留空启用, # 禁用

[Rule]
URL-REGEX, "^http:\/\/\w{32}\.jddebug\.com\/diagnose\?", REJECT

[Body Rewrite]
http-response (?i)^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=lite_advertising jdLiteAdvertisingVO sooyaaabo
http-response-jq (?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=basicConfig 'if ((getpath(["data","JDMessage","socketmonitor"]) // {}) | has("isSocketEstablishedAhead")) then (setpath(["data","JDMessage","socketmonitor","isSocketEstablishedAhead"]; 0)) else . end | if ((getpath(["data","JDMessage","socketmonitor"]) // {}) | has("isSocketReport")) then (setpath(["data","JDMessage","socketmonitor","isSocketReport"]; 0)) else . end | if ((getpath(["data","JDHttpToolKit","httpdns"]) // {}) | has("httpdns")) then (setpath(["data","JDHttpToolKit","httpdns","httpdns"]; 0)) else . end'
http-response-jq (?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=cart 'delpaths([["cartLocationMap","loc_emptyCartFloor2"],["emptyCartRecommendFloor"]])'

[Map Local]
(?i)^https?:\/\/m\.360buyimg\.com\/mobilecms\/s1125x2436_jfs data-type=text data="" status-code=200
(?i)^https?:\/\/api\.m\.jd\.com\/\?(?:[^#?&]+&)*loginType=11 data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=getWidgetV1052 data-type=text data="" status-code=404
(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=(?:cartCouponRecommendGoods|intelligentRecommendSku|obtainGrowingInfo|recommendShop|searchBoxWord|stationPullService|uniformRecommend) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=(searchBoxWord|stationPullService|uniformRecommend[06]) data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[Script]
京东_移除广告 = type=http-response, pattern=(?i)^https:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=(?:deliverLayer|getTabHomeInfo|myOrderInfo|orderTrackBusiness|personinfoBusiness|start|welcomeHome), script-path=https://raw.githubusercontent.com/xfoxtbat/surge-adblock-hub/main/scripts/vendor/rucu6_jingdong.js, requires-body=true
京东比价_获取慢慢买Cookie = type=http-request, pattern=(?i)^https?:\/\/apapia-sqk-weblogic\.manmanbuy\.com\/baoliao\/center\/menu$, script-path=https://raw.githubusercontent.com/xfoxtbat/surge-adblock-hub/main/scripts/vendor/mw418_jd_price.js, requires-body=true, timeout=60
京东比价_标题嵌入版 = type=http-response, pattern=(?i)^https?:\/\/api\.m\.jd\.com\/client\.action\?(?:[^#?&]+&)*functionId=(wareBusiness|serverConfig|basicConfig), script-path=https://raw.githubusercontent.com/xfoxtbat/surge-adblock-hub/main/scripts/vendor/wf021325_jd_price.js, requires-body=true
京东比价_详情通知版 = type=http-request, pattern=(?i)^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://raw.githubusercontent.com/xfoxtbat/surge-adblock-hub/main/scripts/vendor/mw418_jd_price.js, timeout=60
京东比价_详情嵌入版（表格图） = type=http-response, pattern=(?i)^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://raw.githubusercontent.com/xfoxtbat/surge-adblock-hub/main/scripts/vendor/wf021325_jd_price.js, requires-body=true, timeout=60
京东比价_详情嵌入版（折线图） = type=http-response, pattern=(?i)^https?:\/\/in\.m\.jd\.com\/product\/graphext\/\d+\.html, script-path=https://raw.githubusercontent.com/xfoxtbat/surge-adblock-hub/main/scripts/vendor/103516_JingDong.price.js, requires-body=true, timeout=60

[MITM]
hostname = %APPEND% api.m.jd.com, in.m.jd.com, apapia-sqk-weblogic.manmanbuy.com, m.360buyimg.com
