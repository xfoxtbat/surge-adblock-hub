#!name=百度地图 去广告 (Adblock Hub)
#!desc=融合 103516 与可莉双源并自动修复 Surge 兼容问题。上游最新日期：2026-11-02 21:00。修复多数组索引 delpaths 拆分错位问题，自动补全漏掉的 maphotel.baidu.com MITM 域名。注意：可莉原版标注 App Store 版可能因 SSL Pinning 无法解密。
#!category=去广告
#!date=2026-11-02 21:00
#!homepage=https://github.com/xfoxtbat/surge-adblock-hub

[Body Rewrite]
http-response-jq (?i)^https?:\/\/.*map\.baidu\.com\/.*govui\/rich_content '.data.posts.content=[]'
http-response-jq (?i)^https?:\/\/httpdns\.baidubce\.com '.data["newclient.map.baidu.com"]={}'
http-response-jq (?i)^https?:\/\/newclient\.map\.baidu\.com\/usercenter\/mine\/page 'del(.data.sport_card, .data.gold, .data.gold_coin_card, .data.shop)'
http-response-jq (?i)^https?:\/\/newclient\.map\.baidu\.com\/living\/nearby\/hot-words\? '.Result.data=[]'
http-response-jq (?i)^https:\/\/newclient\.map\.baidu\.com\/feed\/govui\/rich_content 'delpaths([["data"]])'
http-response-jq (?i)^https:\/\/newclient\.map\.baidu\.com\/client\/noticebar\/get\? 'delpaths([["content","multi_data"]])'
http-response-jq (?i)^https:\/\/newclient\.map\.baidu\.com\/(client\/)?usersystem\/mine\/page\? 'if ((getpath([]) // {}) | has("data")) then (setpath(["data"]; "{}")) else . end'
http-response-jq (?i)^https:\/\/newclient\.map\.baidu\.com\/client\/phpui2\/\?(?:[^#?&]+&)*qt=ads&type=user_home_new_service 'delpaths([["ads"]])'
http-response-jq (?i)^https:\/\/newclient\.map\.baidu\.com\/living\/nearby\/api\? 'delpaths([["Result","cards",1],["Result","cards",4],["Result","cards",5],["Result","cards",9]])'

[Map Local]
(?i)^https?:\/\/newclient\.map\.baidu\.com\/client\/phpui.*qt=hw data-type=text data="" status-code=200
(?i)^https?:\/\/newclient\.map\.baidu\.com\/client\/phpui2\/\?(?:[^#?&]+&)*qt=ads data-type=text data="" status-code=200
(?i)^https?:\/\/newclient\.map\.baidu\.com\/client\/crossmarketing data-type=text data="" status-code=200
(?i)^https?:\/\/newclient\.map\.baidu\.com\/client\/usersystem\/home\/dynamic data-type=text data="" status-code=200
(?i)^https?:\/\/newclient\.map\.baidu\.com\/contributor-bus\/bounty\/tips data-type=text data="" status-code=200
(?i)^https:\/\/afd\.baidu\.com\/afd\/entry\?(?:[^#?&]+&)*action=(update|query) data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/yongche\.baidu\.com\/gomarketing\/api\/popup\/getentrancecordovaurl$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/cobuild\/pull\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/operationgirdle$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/yongche\.baidu\.com\/goorder\/passenger\/baseinfo$ data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/ecom\.map\.baidu\.com\/ad-ops\/afd\/popup\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"
(?i)^https:\/\/maphotel\.baidu\.com\/hotel\/goextranet\/activity\/detail\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% 180.76.76.200, newclient.map.baidu.com, httpdns.baidubce.com, ugc.map.baidu.com, afd.baidu.com, yongche.baidu.com, ecom.map.baidu.com, maphotel.baidu.com
